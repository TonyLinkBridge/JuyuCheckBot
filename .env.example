# 从 @BotFather 获取
BOT_TOKEN=123456789:replace_me
BOT_USERNAME=JuyuCheckBot

# 需要订阅的公开频道。Bot 必须是频道管理员，才能可靠查询成员状态。
CHANNEL_USERNAME=JUYU007
CHANNEL_URL=https://t.me/JUYU007
CHANNEL_NAME=JUYU 聚域｜域名情报局

# Commerce Bot，用于买卖委托导流
COMMERCE_BOT_USERNAME=JuyuDomainBot

# 本地默认 long polling；填写公网地址后自动使用 webhook
WEBHOOK_URL=
WEBHOOK_SECRET=replace_with_a_long_random_string
PORT=3000

# 外部检查超时，单位毫秒
CHECK_TIMEOUT_MS=8000

# 可选：以后连接 Supabase 时再填写。Service Role Key 只能放后端环境变量。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
