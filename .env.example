# 从 @BotFather 获取
BOT_TOKEN=123456789:replace_me
BOT_USERNAME=JuyuCheckBot

# 需要订阅的公开频道。Bot 必须是频道管理员，才能可靠查询成员状态。
CHANNEL_USERNAME=JUYU007
CHANNEL_URL=https://t.me/JUYU007
CHANNEL_NAME=JUYU 聚域｜域名情报局

# 新 Lead 会先存入 Supabase，再发送到这个 Telegram 私聊或管理员群。
ADMIN_CHAT_ID=

# 本地默认拒绝启动 Bot，不会修改正式 Webhook 或菜单。
# 仅对独立测试 Bot 显式启用；已有 Webhook 的 Bot 仍会被拒绝。
LOCAL_POLLING=false
# 正式 Webhook 仅通过 webhook:set 显式配置，不能由本地启动自动接管。
WEBHOOK_URL=
WEBHOOK_SECRET=replace_with_a_long_random_string
PORT=3000

# 外部检查超时，单位毫秒
CHECK_TIMEOUT_MS=8000

# Vercel 部署必须连接 Supabase，以便跨函数实例读取并解锁报告。
# Service Role Key 只能放后端环境变量。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Growth Dashboard 独立 Vercel Project 使用，至少 12 位。不要与 Bot Token 或 Webhook Secret 共用。
DASHBOARD_PASSWORD=
# 可选：独立 Bot 部署时覆盖；默认使用正式 Check Bot 的 /health。
BOT_HEALTH_URL=https://juyu-check-bot.vercel.app/health

# Growth Dashboard 的 Poll 发布器。Token 只在 Dashboard 服务器端使用。
TELEGRAM_BOT_TOKEN=
POLL_TEST_CHAT_ID=@juyuofficial
POLL_PRODUCTION_CHAT_ID=@JUYU007

# Growth Dashboard 默认停用旧 Commerce 读取；保留旧配置不会发起请求。
# 只有需要恢复历史读取时才明确设置为 true（无需删除旧配置或数据库）。
LEGACY_COMMERCE_ENABLED=false
COMMERCE_SUPABASE_URL=
COMMERCE_SUPABASE_SECRET_KEY=
