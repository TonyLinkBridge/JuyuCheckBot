{
  "name": "juyu-domain-check-bot",
  "version": "0.11.0",
  "private": true,
  "description": "JUYU 域名体检 Telegram Growth Bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:typecheck": "npm --prefix dashboard run typecheck"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "grammy": "^1.38.2",
    "tldts": "^7.0.13",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
